# 実デプロイ先の設定。`.deploy.env` にコピーして実値を書く（.deploy.env は gitignore 済み）。
#
#   cp .deploy.env.example .deploy.env
#   → WORKERS_SUBDOMAIN を自分の workers.dev サブドメインに書き換える
#   → npm run deploy
#
# 最も簡単: サブドメインだけ指定（4オリジンを issuer/verifier/web-wallet/admin.<sub>.workers.dev に展開）
WORKERS_SUBDOMAIN=my-subdomain

# カスタムドメイン等で個別指定したい場合はこちらが優先される（任意）
#ISSUER_URL=https://issuer.example.com
#VERIFIER_ORIGIN=https://verifier.example.com
#WALLET_ORIGIN=https://wallet.example.com
# 自治体窓口（交付申請の審査。職員向けで住民には配らない）
#ADMIN_ORIGIN=https://admin.example.com

# 認可 redirect_uri 許可リスト（オープンリダイレクタ対策）。
# 未指定なら ISSUER_URL/WALLET_ORIGIN から自動導出（issuer /demo/cb + wallet /oidc/cb）。
# 追加のローカル/検証オリジンを許可したいときだけ、空白区切りで明示指定する（任意）。
#REDIRECT_URI_ALLOWLIST=https://issuer.example.com/demo/cb https://wallet.example.com/oidc/cb http://localhost:8787/oidc/cb

# ウォレットのサーバ側 fetch 許可オリジン（SSRF 対策）。
# 未指定なら ISSUER_URL/VERIFIER_ORIGIN/WALLET_ORIGIN から自動導出。明示指定は空白区切り（任意）。
#SSRF_ALLOWED_ORIGINS=https://issuer.example.com https://verifier.example.com https://wallet.example.com

# ---- 適合テスト（OpenID conformance suite）---------------------------------
# ここから下はデプロイには使わない。scripts/conformance-*.mjs だけが読む。
#
# 接続先。未指定なら Docker のセルフホスト（自己署名証明書・TLS 検証を自動で切る）。
# 公式インスタンスを常用するならここに書く。Docker と行き来するなら書かずに
# 実行時へ渡す: SUITE_URL=https://www.certification.openid.net node scripts/…
#SUITE_URL=https://www.certification.openid.net

# 公式インスタンスの API トークン（**セルフホストでは不要**）。
#   1) ブラウザでログイン（Google 可）→ https://www.certification.openid.net/tokens で発行
#   2) 下の行のコメントを外して値を貼る。**クォートで囲まない**
#      （読み取りは `=` より後ろを全部値として扱うので、" ごとトークンになる）
# 公式 CI と同じ `Authorization: Bearer <token>` として送られる
# （conformance-suite/scripts/conformance.py が CONFORMANCE_TOKEN を読んでこの形にしている）。
# 401 はトークン失効か suite の再デプロイ。**この値は会話にもログにも出さない**。
#CONFORMANCE_TOKEN=
#
# 公式インスタンスで回すときは、本番側にも設定が要る（自動導出されない）:
#   - REDIRECT_URI_ALLOWLIST に https://www.certification.openid.net/test/a/<alias>/…
#   - クライアント登録表（KV `_clients:config`）に suite 用の client_id
# alias はテスト計画を作ってからでないと決まらないので、その段で足す。
